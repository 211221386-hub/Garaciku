{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garaciku",
  "main": "./worker.js",
  "keep_vars": true,
  "compatibility_date": "2026-10-01",
  "vars": {
    "APP_ORIGIN": "https://garaciku.211221386.workers.dev",
    "SUPABASE_URL": "https://ncbsukeneywkkscnkcrv.supabase.co"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
